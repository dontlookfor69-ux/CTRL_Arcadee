[Unit]
Description=CTRL Arcade Godot Frontend
After=network.target graphical-session.target display-manager.service
Wants=graphical-session.target

[Service]
Type=simple
User=ctrl
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/ctrl/.Xauthority
WorkingDirectory=/home/ctrl/Desktop/CTRL_Arcadee/frontend/godot_project
ExecStartPre=/bin/bash -c 'i=0; until xset q &>/dev/null || [ $i -gt 60 ]; do sleep 1; i=$((i+1)); done'
ExecStart=/bin/bash start_arcade.sh
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

[Install]
WantedBy=graphical-session.target
